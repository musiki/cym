filters:
  and:
    - '!file.name.contains("MOC")'
    - file.ext != "base"
    - file.ext != "gif"
views:
  - type: cards
    name: sistemas paramétricos
    filters:
      and:
        - file.folder == "06-out/sistemas paramétricos"
  - type: cards
    name: operativos artísticos
    filters:
      and:
        - file.folder == "06-out/operativos artísticos"
