filters:
  and:
    - file.folder == "06-out/personas"
    - '!file.name.startsWith("t-")'
    - file.ext != "base"
views:
  - type: cards
    name: all
    groupBy:
      property: "tags:"
      direction: ASC
    order:
      - file.name
      - year
      - tags
    sort:
      - property: year
        direction: ASC
    image: note.img
    imageFit: ""
    imageAspectRatio: 0.85
    cardSize: 140
  - type: cards
    name: pioneros
    filters:
      and:
        - file.tags.contains("pioneer")
    order:
      - file.name
      - year
      - file.tags
    image: note.img
  - type: cards
    name: argentinxs
    filters:
      and:
        - file.tags.contains("argentina")
    image: note.img
  - type: cards
    name: artistcoders
    filters:
      and:
        - file.tags.contains("artistcoders")
    order:
      - file.name
      - year
      - tags
    sort:
      - property: year
        direction: ASC
    image: note.img
    imageFit: ""
    imageAspectRatio: 0.85
    cardSize: 140
  - type: table
    name: list
    groupBy:
      property: "tags:"
      direction: ASC
    order:
      - file.name
      - year
      - tags
    sort:
      - property: tags
        direction: ASC
      - property: year
        direction: ASC
    image: note.img
    imageFit: ""
    imageAspectRatio: 0.85
    cardSize: 140
  - type: cards
    name: scientists
    filters:
      and:
        - file.tags.contains("science")
    order:
      - file.name
    sort:
      - property: file.name
        direction: ASC
    image: note.img
    imageAspectRatio: 0.6
