filters:
  and:
    - file.ext != "html"
    - file.ext != "js"
    - '!file.name.startsWith("Icon")'
    - '!file.name.startsWith("t-")'
views:
  - type: table
    name: Table
    groupBy:
      property: file.ext
      direction: ASC
    order:
      - file.name
      - type
      - tags
      - year
      - person
    sort:
      - property: type
        direction: ASC
      - property: year
        direction: ASC
    columnSize:
      note.tags: 192
      note.year: 108
